{
  "name": "cc-archos-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:fresh": "node --env-file-if-exists=.env.local scripts/dev-fresh.mjs",
    "prebuild": "node scripts/write-indexnow-keyfile.mjs",
    "indexnow:submit-sitemap": "node scripts/indexnow-submit-sitemap.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.eval.config.ts",
    "prepare": "husky",
    "wip": "node scripts/wip.mjs",
    "new-branch": "node scripts/new-branch.mjs",
    "sync-branch": "node scripts/sync-branch.mjs",
    "migration-safety": "node scripts/_check-migration-safety.mjs",
    "extract-content": "node scripts/extract-content.mjs",
    "migrate-integration-secrets": "node --env-file=.env.local scripts/migrate-integration-secrets.mjs",
    "rotate-master-key": "node --env-file=.env.local scripts/rotate-master-key.mjs",
    "reset-admin-password": "node --env-file=.env.local scripts/reset-admin-password.mjs",
    "db:generate": "node --env-file=.env.local --no-warnings ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local scripts/db-apply.mjs",
    "db:studio": "node --env-file=.env.local --no-warnings ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed-diagnostic-content": "node --env-file=.env.local scripts/seed-diagnostic-content.mjs",
    "db:backfill-users-from-leads": "node --env-file=.env.local scripts/backfill-users-from-leads.mjs",
    "wiki:state": "node scripts/wiki-state.mjs",
    "wiki:search": "node scripts/wiki-search.mjs",
    "wiki:graph": "node scripts/wiki-graph.mjs",
    "wiki:ingest": "node scripts/wiki-ingest.mjs",
    "wiki:lint": "node scripts/wiki-lint.mjs",
    "inventory:wp": "node --env-file=.env.local scripts/inventory-wp.mjs",
    "migrate-wp:dry-run": "node --env-file=.env.local --import tsx scripts/migrate-wp/index.ts --dry-run",
    "migrate-wp:apply": "node --env-file=.env.local --import tsx scripts/migrate-wp/index.ts --apply",
    "migrate-wp:tsc": "tsc --noEmit -p tsconfig.migrate-wp.json",
    "seed:blog-author": "node --env-file=.env.local --import tsx scripts/seed/blog-author-backfill.ts",
    "calibrate:threshold": "node --env-file=.env.local --import tsx scripts/calibrate-threshold.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "image-size": "^2.0.2",
    "jose": "^6.2.3",
    "next": "16.2.5",
    "postgres": "^3.4.9",
    "puppeteer": "^24.43.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "lint-staged": "^17.0.4",
    "mysql2": "^3.22.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": "eslint --fix"
  }
}
