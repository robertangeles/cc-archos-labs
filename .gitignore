# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/screenshots
/playwright-report
/test-results
/tmp

# migrate-wp run artefacts (regenerable manifests + preview outputs)
/scripts/migrate-wp/output/

# Throwaway DB-verification scripts (leading underscore convention)
/scripts/_*.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Claude Code local cache (per-session artifacts; never repo content)
.claude/*
# Exceptions: gstack team-mode files are shared across the team
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/check-gstack.sh
!.claude/settings.json
# Shared subagents (e.g. the dedicated pr-reviewer) live in the repo
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — local secrets ignored, .env.example committed as documentation
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wiki graph — regenerable from frontmatter + [[refs]] via `pnpm wiki:graph build`
wiki/.graph.json

# IndexNow key file — generated by scripts/write-indexnow-keyfile.mjs from
# the INDEXNOW_KEY env var at build time. Kept out of git so the key can
# be rotated by changing the env var alone (no commit + push needed).
# The filename IS the key value per IndexNow Option 1; if you ever commit
# a real .txt file under public/, name it explicitly in a !-include below.
public/*.txt
.gstack/

# Retag snapshots — timestamped local safety copies, regenerated on every --apply
knowledge-corpus-before-retag-*.json
